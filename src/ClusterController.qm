<?xml version="1.0" encoding="UTF-8"?>
<model version="5.1.3" links="0">
 <documentation>This is a little more advanced ClusterController example for the Arduino DUE board. The example demonstrates:

1. One active object class &quot;ClusterController&quot; (inside the package &quot;AOs&quot;)
2. A simple state machine
3. The Board Support Package (BSP), see below.

----
# Board configuration:

The external LED needs to be connected between the pins GND and 13, with the short LEG leg at the GND pin.

----
# More info

This example demonstrates the concept of the Board Support Package (BSP), which separates the &quot;What&quot; needs to be done from &quot;How&quot; this is done. The BSP consists of two files &quot;bsp.h&quot; and &quot;bsp.cpp&quot;. The application (active objects) need to include only the &quot;bsp.h&quot; header file and the state machines call only the BSP functions, but don't interact with the hardware directly.

This structure of the code is recommended for applications with only one active object. (See also the dpp_bsp example).</documentation>
 <framework name="qpcpp"/>
 <package name="AOs" stereotype="0x02" namespace="CC::">
  <class name="Cluster" superclass="qpcpp::QActive">
   <attribute name="instance" type="Cluster" visibility="0x00" properties="0x01">
    <documentation>static class instance (Singleton)</documentation>
   </attribute>
   <operation name="Cluster" type="" visibility="0x00" properties="0x00">
    <code>: QActive(Q_STATE_CAST(&amp;Cluster::initial))</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action brief="initializeAndSubscribe()">FSP::Cluster_initializeAndSubscribe(this, e);</action>
     <initial_glyph conn="49,10,4,0,4">
      <action box="1,0,21,2"/>
     </initial_glyph>
    </initial>
    <state name="ClusterOn">
     <entry brief="activateCommandInterfaces()">FSP::Cluster_activateCommandInterfaces(this, e);</entry>
     <exit brief="deactivateCommandInterfaces()">FSP::Cluster_deactivateCommandInterfaces(this, e);</exit>
     <initial target="../4">
      <initial_glyph conn="60,20,4,0,3">
       <action box="0,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="RESET" target="../4">
      <tran_glyph conn="31,25,3,3,11">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="POWER_OFF" target="../4">
      <tran_glyph conn="31,27,3,3,11">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state name="PowerOn">
      <entry brief="powerOn()">FSP::Cluster_powerOn(this, e);</entry>
      <state_glyph node="42,32,25,6">
       <entry box="1,2,20,2"/>
      </state_glyph>
     </state>
     <state name="PowerOff">
      <entry brief="PowerOff()">FSP::Cluster_powerOff(this, e);</entry>
      <tran trig="POWER_ON" target="../../3">
       <tran_glyph conn="54,28,2,0,4">
        <action box="2,1,10,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="42,23,25,5">
       <entry box="1,2,17,2"/>
      </state_glyph>
     </state>
     <state_glyph node="31,14,67,44">
      <entry box="1,2,23,2"/>
      <exit box="1,4,24,2"/>
     </state_glyph>
    </state>
    <state_diagram size="131,68"/>
   </statechart>
  </class>
  <class name="SerialCommandInterface" superclass="qpcpp::QActive">
   <attribute name="serial_time_evt_" type="QP::QTimeEvt" visibility="0x00" properties="0x00"/>
   <attribute name="instance" type="SerialCommandInterface" visibility="0x00" properties="0x01"/>
   <operation name="SerialCommandInterface" type="" visibility="0x00" properties="0x00">
    <code>: QActive(Q_STATE_CAST(&amp;SerialCommandInterface::initial)),
    serial_time_evt_(this, SERIAL_TIMEOUT_SIG, 0U)</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../2">
     <action brief="subscribe()">FSP::SerialCommandInterface_subscribe(this, e);</action>
     <initial_glyph conn="46,8,4,0,3">
      <action box="1,0,12,2"/>
     </initial_glyph>
    </initial>
    <state name="Active">
     <initial target="../2">
      <initial_glyph conn="34,28,4,0,4">
       <action box="0,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="DEACTIVATE_SERIAL_COMMAND_INTERFACE" target="../../2">
      <tran_glyph conn="23,27,3,3,-3,-14,17">
       <action box="-22,-16,35,2"/>
      </tran_glyph>
     </tran>
     <state name="NotReady">
      <entry brief="beginSerial()">FSP::SerialCommandInterface_beginSerial(this, e);</entry>
      <tran trig="SERIAL_READY" target="../../3">
       <tran_glyph conn="49,34,1,1,14,11,-5">
        <action box="0,-2,13,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="27,32,22,8">
       <entry box="1,2,13,2"/>
      </state_glyph>
     </state>
     <state name="Ready">
      <entry brief="armSerialTimer()">FSP::SerialCommandInterface_armSerialTimer(this, e);</entry>
      <exit brief="disarmSerialTimer()">FSP::SerialCommandInterface_disarmSerialTimer(this, e);</exit>
      <tran trig="SERIAL_TIMEOUT">
       <action brief="pollSerialCommand()">FSP::SerialCommandInterface_pollSerialCommand(this, e);</action>
       <tran_glyph conn="27,53,3,-1,16">
        <action box="0,-2,24,4"/>
       </tran_glyph>
      </tran>
      <state_glyph node="27,43,31,18">
       <entry box="1,2,20,2"/>
       <exit box="1,4,19,2"/>
      </state_glyph>
     </state>
     <state_glyph node="23,21,42,46"/>
    </state>
    <state name="Inactive">
     <tran trig="ACTIVATE_SERIAL_COMMAND_INTERFACE" target="../../1">
      <tran_glyph conn="55,13,1,1,18,12,-8">
       <action box="2,-2,35,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="37,11,18,7"/>
    </state>
    <state_diagram size="97,69"/>
   </statechart>
  </class>
  <class name="EthernetCommandInterface" superclass="qpcpp::QActive">
   <attribute name="instance" type="EthernetCommandInterface" visibility="0x00" properties="0x01"/>
   <attribute name="ethernet_time_evt_" type="QP::QTimeEvt" visibility="0x00" properties="0x00"/>
   <operation name="EthernetCommandInterface" type="" visibility="0x00" properties="0x00">
    <code>: QActive(Q_STATE_CAST(&amp;EthernetCommandInterface::initial)),
    ethernet_time_evt_(this, ETHERNET_TIMEOUT_SIG, 0U)</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action brief="initializeAndSubscribe()">FSP::EthernetCommandInterface_initializeAndSubscribe(this, e);</action>
     <initial_glyph conn="55,2,4,0,3">
      <action box="1,0,18,2"/>
     </initial_glyph>
    </initial>
    <state name="Inactive">
     <tran trig="ACTIVATE_ETHERNET_COMMAND_INTERFACE" target="../../2">
      <tran_glyph conn="63,7,1,1,52,15,-8">
       <action box="1,-2,36,3"/>
      </tran_glyph>
     </tran>
     <state_glyph node="49,5,14,9"/>
    </state>
    <state name="Active">
     <entry brief="armEthernetTimer()">FSP::EthernetCommandInterface_armEthernetTimer(this, e);</entry>
     <exit brief="disarmEthernetTimer()">FSP::EthernetCommandInterface_disarmEthernetTimer(this, e);</exit>
     <initial target="../2">
      <initial_glyph conn="12,29,5,3,3">
       <action box="0,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="DEACTIVATE_ETHERNET_COMMAND_INTERFACE" target="../../1">
      <tran_glyph conn="8,22,3,3,-2,-15,43">
       <action box="0,-17,39,2"/>
      </tran_glyph>
     </tran>
     <state name="Unintitalized">
      <tran trig="ETHERNET_INITIALIZED" target="../../3">
       <tran_glyph conn="43,29,1,1,6,11,-2">
        <action box="1,-3,19,2"/>
       </tran_glyph>
      </tran>
      <tran trig="ETHERNET_TIMEOUT">
       <action brief="beginEthernet()">FSP::EthernetCommandInterface_beginEthernet(this, e);</action>
       <tran_glyph conn="15,32,3,-1,18">
        <action box="0,-2,18,5"/>
       </tran_glyph>
      </tran>
      <state_glyph node="15,25,28,10"/>
     </state>
     <state name="Initialized">
      <tran trig="ETHERNET_SERVER_INITIALIZED" target="../../4">
       <tran_glyph conn="47,43,1,0,4,9">
        <action box="5,2,27,2"/>
       </tran_glyph>
      </tran>
      <tran trig="ETHERNET_TIMEOUT">
       <action brief="beginServer()">FSP::EthernetCommandInterface_beginServer(this, e);</action>
       <tran_glyph conn="15,45,3,-1,18">
        <action box="0,-2,18,4"/>
       </tran_glyph>
      </tran>
      <state_glyph node="15,38,32,11"/>
     </state>
     <state name="ServerRunning">
      <tran trig="ETHERNET_TIMEOUT">
       <action brief="pollEthernetCommand()">FSP::EthernetCommandInterface_pollEthernetCommand(this, e);</action>
       <tran_glyph conn="15,57,3,-1,23">
        <action box="0,-2,19,4"/>
       </tran_glyph>
      </tran>
      <state_glyph node="15,52,42,11"/>
     </state>
     <state_glyph node="8,16,99,59">
      <entry box="1,2,24,2"/>
      <exit box="1,4,24,2"/>
     </state_glyph>
    </state>
    <state_diagram size="124,91"/>
   </statechart>
  </class>
  <class name="Watchdog" superclass="qpcpp::QActive">
   <attribute name="instance" type="Watchdog" visibility="0x00" properties="0x01"/>
   <attribute name="watchdog_time_evt_" type="QP::QTimeEvt" visibility="0x00" properties="0x00"/>
   <operation name="Watchdog" type="" visibility="0x00" properties="0x00">
    <code>: QActive(Q_STATE_CAST(&amp;Watchdog::initial)),
    watchdog_time_evt_(this, WATCHDOG_TIMEOUT_SIG, 0U)</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action brief="initializeAndSubscribe()">FSP::Watchdog_initializeAndSubscribe(this, e);</action>
     <initial_glyph conn="24,9,4,0,4">
      <action box="1,1,18,2"/>
     </initial_glyph>
    </initial>
    <state name="Feeding">
     <entry brief="armWatchdogTimer()">FSP::Watchdog_armWatchdogTimer(this, e);</entry>
     <exit brief="disarmWatchdogTimer()">FSP::Watchdog_disarmWatchdogTimer(this, e);</exit>
     <tran trig="WATCHDOG_TIMEOUT">
      <action brief="feedWatchdog()">FSP::Watchdog_feedWatchdog(this, e);</action>
      <tran_glyph conn="18,26,3,-1,13">
       <action box="0,-5,19,4"/>
      </tran_glyph>
     </tran>
     <tran trig="RESET" target="../../2">
      <tran_glyph conn="26,31,2,0,8">
       <action box="1,3,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="18,13,22,18">
      <entry box="1,2,21,2"/>
      <exit box="1,4,21,2"/>
     </state_glyph>
    </state>
    <state name="Resetting">
     <state_glyph node="18,39,22,12"/>
    </state>
    <state_diagram size="90,73"/>
   </statechart>
  </class>
 </package>
 <package name="Shared" stereotype="0x00" namespace="CC::">
  <class name="CommandEvt" superclass="qpcpp::QEvt"/>
  <attribute name="AO_Cluster" type="QP::QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;Cluster::instance;</code>
  </attribute>
  <attribute name="AO_SerialCommandInterface" type="QP::QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;SerialCommandInterface::instance;</code>
  </attribute>
  <attribute name="AO_EthernetCommandInterface" type="QP::QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;EthernetCommandInterface::instance;</code>
  </attribute>
  <attribute name="AO_Watchdog" type="QP::QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;Watchdog::instance;</code>
  </attribute>
 </package>
 <directory name=".">
  <file name="ClusterController.hpp">
   <text>#ifndef CLUSTER_CONTROLLER_HPP
#define CLUSTER_CONTROLLER_HPP

#include &quot;qpcpp.hpp&quot;
#include &quot;fsp.hpp&quot;


namespace ArduinoInterface
{
void setup();
void loop();
}

$declare${Shared}

#endif</text>
  </file>
  <file name="Cluster.hpp">
   <text>#ifndef CLUSTER_HPP
#define CLUSTER_HPP

#include &quot;ClusterController.hpp&quot;


//============================================================================
// generate declaration of the active object
$declare${AOs::Cluster}

#endif</text>
  </file>
  <file name="SerialCommandInterface.hpp">
   <text>#ifndef SERIAL_COMMAND_INTERFACE_HPP
