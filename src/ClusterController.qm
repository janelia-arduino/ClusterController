<?xml version="1.0" encoding="UTF-8"?>
<model version="5.1.3" links="0">
 <documentation>This is a little more advanced ClusterController example for the Arduino DUE board. The example demonstrates:

1. One active object class &quot;ClusterController&quot; (inside the package &quot;AOs&quot;)
2. A simple state machine
3. The Board Support Package (BSP), see below.

----
# Board configuration:

The external LED needs to be connected between the pins GND and 13, with the short LEG leg at the GND pin.

----
# More info

This example demonstrates the concept of the Board Support Package (BSP), which separates the &quot;What&quot; needs to be done from &quot;How&quot; this is done. The BSP consists of two files &quot;bsp.h&quot; and &quot;bsp.cpp&quot;. The application (active objects) need to include only the &quot;bsp.h&quot; header file and the state machines call only the BSP functions, but don't interact with the hardware directly.

This structure of the code is recommended for applications with only one active object. (See also the dpp_bsp example).</documentation>
 <framework name="qpcpp"/>
 <package name="AOs" stereotype="0x02" namespace="CC::">
  <class name="Cluster" superclass="qpcpp::QActive">
   <attribute name="instance" type="Cluster" visibility="0x00" properties="0x01">
    <documentation>static class instance (Singleton)</documentation>
   </attribute>
   <attribute name="prisms_[constants::prism_count_max]" type="QP::QHsm *" visibility="0x00" properties="0x00"/>
   <attribute name="cluster_time_evt_" type="QP::QTimeEvt" visibility="0x00" properties="0x00"/>
   <operation name="Cluster" type="" visibility="0x00" properties="0x00">
    <code>: QActive(Q_STATE_CAST(&amp;Cluster::initial)),
    cluster_time_evt_(this, CLUSTER_TIMEOUT_SIG, 0U)

for (uint8_t n = 0U; n &lt; constants::prism_count_max; ++n)
{
  prisms_[n] = Prism_getInstance(n);
  Prism * const prism = static_cast&lt;Prism * const&gt;(prisms_[n]);
  prism-&gt;prism_address_ = n;
}</code>
   </operation>
   <operation name="dispatchToAllPrisms" type="void" visibility="0x02" properties="0x00">
    <parameter name="e" type="QP::QEvt const *"/>
    <code>for (uint8_t n = 0U; n &lt; constants::prism_count_max; ++n)
{
  if (prisms_[n] != nullptr)
  {
    prisms_[n]-&gt;dispatch(e, m_prio);
  }
}</code>
   </operation>
   <statechart properties="0x02">
    <initial target="../1">
     <action brief="initializeAndSubscribe()">FSP::Cluster_initializeAndSubscribe(this, e);</action>
     <initial_glyph conn="23,10,4,0,4">
      <action box="1,0,21,2"/>
     </initial_glyph>
    </initial>
    <state name="ClusterOn">
     <entry brief="activateCommandInterfaces()">FSP::Cluster_activateCommandInterfaces(this, e);</entry>
     <exit brief="deactivateCommandInterfaces()">FSP::Cluster_deactivateCommandInterfaces(this, e);</exit>
     <initial target="../4">
      <initial_glyph conn="41,20,4,0,3">
       <action box="0,-2,10,2"/>
      </initial_glyph>
     </initial>
     <tran trig="RESET" target="../4">
      <action brief="dispatchToAllPrisms()">dispatchToAllPrisms(e);</action>
      <tran_glyph conn="5,25,3,3,28">
       <action box="0,-2,24,2"/>
      </tran_glyph>
     </tran>
     <tran trig="POWER_OFF" target="../4">
      <action brief="dispatchToAllPrisms()">dispatchToAllPrisms(e);</action>
      <tran_glyph conn="5,27,3,3,28">
       <action box="0,-2,27,3"/>
      </tran_glyph>
     </tran>
     <state name="AllPrismsPoweredOn">
      <entry brief="armClusterTimer()">FSP::Cluster_armClusterTimer(this, e);</entry>
      <exit brief="disarmClusterTimer()">FSP::Cluster_disarmClusterTimer(this, e);</exit>
      <tran trig="CLUSTER_TIMEOUT">
       <action brief="dispatchToAllPrisms()">dispatchToAllPrisms(e);</action>
       <tran_glyph conn="16,42,3,-1,20">
        <action box="0,-2,19,4"/>
       </tran_glyph>
      </tran>
      <state_glyph node="16,32,70,31">
       <entry box="1,2,22,2"/>
       <exit box="1,4,22,2"/>
      </state_glyph>
     </state>
     <state name="AllPrismsPoweredOff">
      <entry brief="PowerOffAllPrisms()">FSP::Cluster_powerOffAllPrisms(this, e);</entry>
      <tran trig="POWER_ON" target="../../3">
       <action brief="powerOnAllPrisms(); dispatchToAllPrisms()">FSP::Cluster_powerOnAllPrisms(this, e);
dispatchToAllPrisms(e);</action>
       <tran_glyph conn="41,28,2,0,4">
        <action box="1,1,43,2"/>
       </tran_glyph>
      </tran>
      <state_glyph node="33,23,25,5">
       <entry box="1,2,17,2"/>
      </state_glyph>
     </state>
     <state_glyph node="5,14,89,57">
      <entry box="1,2,23,2"/>
      <exit box="1,4,24,2"/>
     </state_glyph>
    </state>
    <state_diagram size="131,112"/>
   </statechart>
  </class>
