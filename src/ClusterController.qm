  <class name="Watchdog" superclass="qpcpp::QActive">
   <attribute name="instance" type="Watchdog" visibility="0x00" properties="0x01"/>
   <attribute name="watchdog_time_evt_" type="QP::QTimeEvt" visibility="0x00" properties="0x00"/>
   <operation name="Watchdog" type="" visibility="0x00" properties="0x00">
    <code>: QActive(Q_STATE_CAST(&amp;Watchdog::initial)),
    watchdog_time_evt_(this, WATCHDOG_TIMEOUT_SIG, 0U)</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action>BSP::initializeWatchdog();
subscribe(RESET_SIG);</action>
     <initial_glyph conn="24,9,4,0,4">
      <action box="0,-2,10,2"/>
     </initial_glyph>
    </initial>
    <state name="Feeding">
     <entry brief="armWatchdogTimer(10Hz)">watchdog_time_evt_.armX(BSP::TICKS_PER_SEC/10, BSP::TICKS_PER_SEC/10);</entry>
     <exit brief="disarmWatchdogTimer()">watchdog_time_evt_.disarm();</exit>
     <tran trig="WATCHDOG_TIMEOUT">
      <action brief="feedWatchdog()">BSP::feedWatchdog();</action>
      <tran_glyph conn="18,26,3,-1,13">
       <action box="0,-5,19,4"/>
      </tran_glyph>
     </tran>
     <tran trig="RESET" target="../../2">
      <tran_glyph conn="26,31,2,0,8">
       <action box="1,3,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="18,13,22,18">
      <entry box="1,2,21,2"/>
      <exit box="1,4,21,2"/>
     </state_glyph>
    </state>
    <state name="Resetting">
     <state_glyph node="18,39,22,12"/>
    </state>
    <state_diagram size="90,73"/>
   </statechart>
  </class>
 </package>
