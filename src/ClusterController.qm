#include &quot;ClusterController.hpp&quot;


//============================================================================
// generate declaration of the active object
$declare${AOs::EthernetCommandInterface}

#endif</text>
  </file>
  <file name="Watchdog.hpp">
   <text>#ifndef WATCHDOG_HPP
#define WATCHDOG_HPP

#include &quot;ClusterController.hpp&quot;


//============================================================================
// generate declaration of the active object
$declare${AOs::Watchdog}

#endif</text>
  </file>
 </directory>
 <directory name="./ClusterController">
  <file name="Cluster.cpp">
   <text>#include &quot;Cluster.hpp&quot;


using namespace QP;

//============================================================================
// generate definition of to opaque pointer to the AO
$define${Shared::AO_Cluster}

//============================================================================
// generate definition of the AO
$define${AOs::Cluster}</text>
  </file>
  <file name="ClusterController.cpp">
   <text>#include &quot;ClusterController.hpp&quot;

using namespace QP;

namespace ArduinoInterface
{
void setup()
{
  FSP::ClusterController_setup();
}

void loop()
{
  QF::run();
}
}</text>
  </file>
  <file name="SerialCommandInterface.cpp">
